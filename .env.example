# Copie para .env (make env faz isso e gera o SECRET_KEY)

# ==================== Docker / Infra ====================
POSTGRES_USER=biveto
POSTGRES_PASSWORD=biveto_secret
POSTGRES_DB=biveto_db
POSTGRES_PORT=5433
API_PORT=8000
# Produção: domínio público da API (usado pelo Caddy para emitir o certificado)
API_DOMAIN=api.biveto.com

# ==================== Banco ====================
# Dentro do docker compose o DATABASE_URL é montado a partir das variáveis POSTGRES_*.
# Rodando sem Docker (uvicorn local), vale este:
DATABASE_URL=sqlite+aiosqlite:///./financeiro.db

# ==================== App ====================
SECRET_KEY=sua-chave-secreta-aqui-mude-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=true
ENVIRONMENT=development
# Só vale com DEBUG=false. App nativo (Android/iOS) não usa CORS; isto é para o Expo Web/painéis.
CORS_ORIGINS=http://localhost:8081
MAX_UPLOAD_SIZE_MB=10

# ==================== IA ====================
VISION_PROVIDER=google
VISION_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# ==================== E-mail ====================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=noreply@biveto.com
SMTP_PASSWORD=
SMTP_FROM_NAME=Biveto
SMTP_FROM_EMAIL=noreply@biveto.com
# Base dos links enviados por e-mail (reset de senha, convite)
FRONTEND_URL=https://biveto.com
