(api) {
	encode gzip zstd

	# Uploads de faturas/cupons (MAX_UPLOAD_SIZE_MB=10 na API; folga para multipart)
	request_body {
		max_size 15MB
	}

	reverse_proxy {args[0]}:8000
}

{$HML_DOMAIN} {
	import api koin-hml-api
}

{$PROD_DOMAIN} {
	import api koin-prod-api
}

# Outros projetos hospedados na VM: um arquivo <projeto>.caddy em /opt/koin/proxy/caddy/sites/.
# Ficam fora deste arquivo porque o deploy do koin-api o sobrescreve (docs/infra/DEPLOY.md).
import /etc/caddy/sites/*.caddy
