# Modelo do /opt/koin/<env>/.env na VM (hml ou prod). Os segredos existem só no servidor.
# Gere as senhas com: openssl rand -hex 32
# API_IMAGE não entra aqui: o deploy grava a tag a cada release.

KOIN_ENV=hml
ENVIRONMENT=staging
DEBUG=false

POSTGRES_USER=koin
POSTGRES_PASSWORD=
POSTGRES_DB=koin_db

SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:8081
MAX_UPLOAD_SIZE_MB=10

VISION_PROVIDER=google
VISION_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=
MISTRAL_API_KEY=

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Koin
SMTP_FROM_EMAIL=
FRONTEND_URL=https://hml.144-22-232-63.sslip.io
