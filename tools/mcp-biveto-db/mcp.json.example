{
  "_comment": "Configuracao do MCP Server do Biveto. Copie este arquivo para .mcp.json e preencha sua API Key.",
  "mcpServers": {
    "biveto-db": {
      "_comment": "Servidor MCP para consultas ao banco de dados do Biveto via API REST.",
      "command": "python",
      "args": [
        "tools/mcp-biveto-db/server.py"
      ],
      "env": {
        "BIVETO_API_URL": "http://localhost:8000/api/v1",
        "BIVETO_API_KEY": "your-api-key-here"
      }
    }
  }
}
