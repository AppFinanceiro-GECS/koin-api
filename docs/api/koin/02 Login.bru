meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "device_name": "Bruno"
  }
}

script:post-response {
  bru.setEnvVar("accessToken", res.body.access_token);
  bru.setEnvVar("refreshToken", res.body.refresh_token);
}

docs {
  Guarda accessToken e refreshToken no ambiente. O access vale 15 min; use Refresh depois.
}
